# DeepSeek (OpenAI-compatible). Copy to .env and fill in your key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Agent / validator defaults (see src/adapters)
DEFAULT_AGENT=cline
DEFAULT_VALIDATOR=none

# Storage backend (Drizzle multi-dialect). sqlite | postgres | mysql
DATABASE_DRIVER=sqlite
# sqlite: a file path. postgres/mysql: a connection string.
DATABASE_URL=./data/studio.db

# Server
PORT=3000
# Start of the Metro port range for GENERATED apps (cockpit dev Metro uses 8081)
METRO_PORT=8100
PROJECTS_DIR=projects
